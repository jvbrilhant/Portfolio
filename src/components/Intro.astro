---
/**
 * Opening sequence on the home page: a record is placed on a turntable, the
 * tonearm swings over, the needle drops and the record spins up. Plays once per
 * browser session, never with reduced motion, and can be skipped (click, key or scroll).
 * The turntable art lives in public/intro as three SVGs drawn upright (portrait)
 * and turned 90deg into landscape by .tt-inner.
 */
import type { Lang } from '../data/projects';
import { url } from '../data/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = {
  en: { now: 'Now playing', what: 'Brilhante: Portfolio', skip: 'Skip intro' },
  pt: { now: 'Tocando agora', what: 'Brilhante: Portfólio', skip: 'Pular intro' },
}[lang];
---

<script is:inline>
  (function () {
    try {
      var seen = sessionStorage.getItem('brl-intro');
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!seen && !reduce) {
        document.documentElement.classList.add('intro-on');
        // Safety net: never leave the page locked if something fails to load.
        setTimeout(function () {
          document.documentElement.classList.remove('intro-on');
        }, 7000);
      }
    } catch (e) {}
  })();
</script>

<div class="intro" data-intro>
  <div class="intro-stage">
    <div class="tt" aria-hidden="true">
      <div class="tt-inner">
        <img class="tt-base" src={url('intro/tt-base.svg')} alt="" decoding="async" />
        <div class="tt-rec" data-tt-rec>
          <img class="tt-spin" data-tt-spin src={url('intro/tt-record.svg')} alt="" decoding="async" />
        </div>
        <img class="tt-arm" data-tt-arm src={url('intro/tt-arm.svg')} alt="" decoding="async" />
      </div>
    </div>

    <p class="intro-caption">
      <span class="intro-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span>{copy.now}</span>
      <strong>{copy.what}</strong>
    </p>
  </div>
  <button type="button" class="intro-skip" data-intro-skip>{copy.skip} →</button>
</div>

<script>
  function runIntro() {
    const root = document.documentElement;
    const el = document.querySelector<HTMLElement>('[data-intro]');
    if (!el || !root.classList.contains('intro-on')) return;
    const lenis = (window as unknown as { __lenis?: { stop(): void; start(): void } }).__lenis;
    lenis?.stop();

    let done = false;
    const timers: number[] = [];
    const finish = () => {
      if (done) return;
      done = true;
      timers.forEach(clearTimeout);
      el.classList.add('is-exit');
      try {
        sessionStorage.setItem('brl-intro', '1');
      } catch {}
      window.setTimeout(() => {
        root.classList.remove('intro-on');
        el.remove();
        lenis?.start();
        window.scrollTo(0, 0);
      }, 750);
      ['wheel', 'touchmove', 'keydown'].forEach((t) => window.removeEventListener(t, finish));
    };

    el.querySelector('[data-intro-skip]')?.addEventListener('click', finish);
    el.addEventListener('click', finish);
    ['wheel', 'touchmove', 'keydown'].forEach((t) => window.addEventListener(t, finish, { passive: true }));

    // Start once the three drawings are decoded (or after 1.2s, whichever comes first).
    const imgs = [...el.querySelectorAll<HTMLImageElement>('.tt img')];
    const ready = Promise.all(imgs.map((i) => i.decode().catch(() => {})));
    const late = new Promise((r) => window.setTimeout(r, 1200));
    Promise.race([ready, late]).then(() => {
      if (done) return;
      el.classList.add('is-ready');
      play(el);
      // Needle lands at 2.5s; the room fades in a second later.
      timers.push(window.setTimeout(finish, 3500));
    });
  }

  /** Record glides in and settles (1.4s), arm swings over and lowers (1s), record spins up to 33⅓ rpm. */
  function play(el: HTMLElement) {
    const rec = el.querySelector<HTMLElement>('[data-tt-rec]');
    const spin = el.querySelector<HTMLElement>('[data-tt-spin]');
    const arm = el.querySelector<HTMLElement>('[data-tt-arm]');
    const tt = el.querySelector<HTMLElement>('.tt');
    if (!rec || !spin || !arm || !tt) return;
    const w = tt.getBoundingClientRect().width;
    const lift = 'drop-shadow(30px 0 30px rgba(0,0,0,.45))';
    const rest = 'drop-shadow(2px 0 3px rgba(0,0,0,.4))';
    rec.animate(
      [
        { transform: `translate(${w * 0.03}px, ${w * 1.15}px) rotate(-140deg) scale(1.06)`, filter: lift },
        { transform: 'translate(0, 0) rotate(0deg) scale(1.06)', filter: lift, offset: 0.82 },
        { transform: 'translate(0, 0) rotate(0deg) scale(1)', filter: rest },
      ],
      { duration: 1400, easing: 'cubic-bezier(.3,.6,.35,1)', fill: 'forwards' },
    );
    const armLow = 'drop-shadow(2px 0 2px rgba(0,0,0,.35))';
    const armHigh = 'drop-shadow(14px 0 10px rgba(0,0,0,.4))';
    const swing = arm.animate(
      [
        { transform: 'rotate(0deg) scale(1)', filter: armLow },
        { transform: 'rotate(1deg) scale(1.015)', filter: armHigh, offset: 0.15 },
        { transform: 'rotate(19deg) scale(1.015)', filter: armHigh, offset: 0.75 },
        { transform: 'rotate(19deg) scale(1)', filter: armLow },
      ],
      { duration: 1000, easing: 'ease-in-out', fill: 'forwards', delay: 1500 },
    );
    // 33⅓ rpm is 1.8s per turn; the ramp ends at that speed.
    swing.finished
      .then(() => spin.animate([{ transform: 'rotate(0deg)' }, { transform: 'rotate(117deg)' }], {
        duration: 700,
        easing: 'cubic-bezier(.5,0,1,1)',
        fill: 'forwards',
      }).finished)
      .then(() => spin.animate([{ transform: 'rotate(117deg)' }, { transform: 'rotate(477deg)' }], {
        duration: 1800,
        iterations: Infinity,
      }))
      .catch(() => {});
  }
  document.addEventListener('astro:page-load', runIntro);
</script>
