---
/**
 * Project image at its natural proportions (never cropped). Rows of images
 * share one height (see .g-row in global.css). Clicking opens the lightbox.
 */
import Media from './Media.astro';
import { url } from '../data/i18n';

interface Props {
  img: { src: string; w: number; h: number; video?: string };
  alt: string;
  eager?: boolean;
  class?: string;
  style?: string;
  zoomLabel: string;
}
const { img, alt, eager = false, class: cls, style = '', zoomLabel } = Astro.props;
const ratio = (img.w / img.h).toFixed(4);
---

<figure class:list={['frame', cls]} style={`--r:${ratio};${style}`}>
  <button
    type="button"
    class="frame-btn"
    data-lb
    data-src={url(img.src)}
    data-video={img.video ? url(img.video) : undefined}
    data-w={img.w}
    data-h={img.h}
    data-alt={alt}
    aria-label={`${zoomLabel}: ${alt}`}
  >
    <Media img={img} alt={alt} eager={eager} />
    <span class="frame-zoom" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="14" height="14"><path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      <span class="frame-zoom-text">{zoomLabel}</span>
    </span>
  </button>
</figure>
