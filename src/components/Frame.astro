---
/**
 * Every project image sits in the same 16:10 frame so the pages keep one rhythm.
 * Landscape screenshots fill the frame; tall or square ones (phones, mockups)
 * are shown whole on a soft panel. Clicking opens the full image in the lightbox.
 */
import Media from './Media.astro';
import { url } from '../data/i18n';

interface Props {
  img: { src: string; w: number; h: number; video?: string };
  alt: string;
  eager?: boolean;
  class?: string;
  style?: string;
  zoomLabel: string;
}
const { img, alt, eager = false, class: cls, style, zoomLabel } = Astro.props;
const ratio = img.w / img.h;
const fill = ratio >= 1.4 && ratio <= 1.95;
---

<figure class:list={['frame', fill ? 'fill' : 'fit', cls]} style={style}>
  <button
    type="button"
    class="frame-btn"
    data-lb
    data-src={url(img.src)}
    data-video={img.video ? url(img.video) : undefined}
    data-w={img.w}
    data-h={img.h}
    data-alt={alt}
    aria-label={`${zoomLabel}: ${alt}`}
  >
    <Media img={img} alt={alt} eager={eager} />
    <span class="frame-zoom" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="16" height="16"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
    </span>
  </button>
</figure>
