---
// Line icons for the Results cards (mobile).
interface Props {
  name: 'years' | 'time' | 'growth' | 'launch' | 'visits' | 'languages' | string;
}
const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'years' && <path d="M6 3h12M6 21h12M7 3c0 4.5 4 6 5 9 1-3 5-4.5 5-9M7 21c0-4.5 4-6 5-9 1 3 5 4.5 5 9" />}
  {name === 'time' && (
    <>
      <circle cx="12" cy="13.5" r="7.5" />
      <path d="M10 2.5h4M12 2.5V6M12 13.5l3-3M19 6.5l1.5-1.5" />
    </>
  )}
  {name === 'growth' && <path d="M3 17l6-6 4 4 8-8M15 7h6v6" />}
  {name === 'launch' && (
    <>
      <path d="M9 15l-3-3c1.5-4.5 5-8 12-9-1 7-4.5 10.5-9 12z" />
      <path d="M5 15c-1.5 1.5-2 5-2 5s3.5-.5 5-2M7.5 12.5L4 12l3-4h4M11.5 16.5L12 20l4-3v-4" />
      <circle cx="14.5" cy="9.5" r="1.5" />
    </>
  )}
  {name === 'visits' && (
    <>
      <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
      <circle cx="12" cy="12" r="3" />
    </>
  )}
  {name === 'languages' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z" />
    </>
  )}
</svg>
