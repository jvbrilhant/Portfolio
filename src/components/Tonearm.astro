---
/**
 * Tonearm drawn in album-width units (the album is 100 wide). The pivot sits up and to the
 * right of the record; on load the arm swings in and the stylus lands on the exposed grooves.
 */
---

<svg class="tonearm" viewBox="0 0 150 120" aria-hidden="true">
  <g class="tonearm-base">
    <circle cx="132" cy="-2" r="9" fill="#1d1a26" stroke="rgba(255,255,255,.18)" stroke-width=".6" />
    <circle cx="132" cy="-2" r="4.2" fill="#2c2836" stroke="rgba(255,255,255,.25)" stroke-width=".5" />
  </g>
  <g class="tonearm-arm">
    <!-- counterweight behind the pivot -->
    <rect x="135" y="-12" width="7" height="9" rx="1.5" transform="rotate(-27.6 132 -2)" fill="#2c2836" stroke="rgba(255,255,255,.2)" stroke-width=".5" />
    <!-- arm tube -->
    <path d="M132 -2 L 112.5 35" stroke="#cfc8dc" stroke-width="1.6" stroke-linecap="round" fill="none" />
    <!-- headshell + cartridge -->
    <g transform="rotate(27.6 110 40)">
      <rect x="107.2" y="33" width="5.6" height="9" rx="1" fill="#e9e4f2" />
      <rect x="108.2" y="41.2" width="3.6" height="2.4" rx=".5" fill="var(--accent)" />
    </g>
    <circle cx="132" cy="-2" r="2" fill="#cfc8dc" />
  </g>
</svg>
