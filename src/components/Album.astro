---
import Cover from './Cover.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  /** Keep the record out of the sleeve (used on project pages). */
  out?: boolean;
  eager?: boolean;
}
const { project, out = false, eager = false } = Astro.props;
---

<div class:list={['album', { out }]} data-album style={`--label:${project.label}`}>
  <div class="record" aria-hidden="true">
    <div class="record-disc"></div>
    <div class="record-label"><span>{project.cat}</span></div>
  </div>
  <div class="sleeve" transition:name={`sleeve-${project.slug}`}>
    <Cover project={project} eager={eager} />
  </div>
</div>
