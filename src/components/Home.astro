---
import Layout from '../layouts/Layout.astro';
import Album from './Album.astro';
import Flag from './Flag.astro';
import Eq from './Eq.astro';
import Intro from './Intro.astro';
import { decor } from '../data/decor';
import { projects, type Lang } from '../data/projects';
import { t, url, homePath, projectPath, experience, contact } from '../data/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'en' ? 'pt' : 'en';
const name = 'Brilhante';
---

<Layout lang={lang} altPath={homePath(other)} footer={false}>
  <Intro lang={lang} />
  <section class="hero" id="top">
    <div class="wrap hero-grid">
      <div class="hero-id reveal">
        <img class="avatar" src={url('me/avatar.webp')} width="400" height="400" alt={s.hero.avatarAlt} />
        <p class="hero-role">
          {s.hero.eyebrow.split(' · ').map((r, i) => (
            <>
              {i > 0 && <span class="role-sep" aria-hidden="true"> · </span>}
              <span class="role">{r}</span>
            </>
          ))}
        </p>
      </div>
      {decor.grooves && <div class="grooves" aria-hidden="true"></div>}
      <h1 class="hero-name" aria-label={name}>
        <span class="clip" aria-hidden="true">
          {name.split('').map((c, i) => <span class="char" style={`--i:${i}`}>{c}</span>)}
        </span>
      </h1>
      <div class="hero-bottom">
        <div class="reveal" style="--d:.5s">
          <p class="hero-lead">{s.hero.lead}</p>
          <p class="hero-based">{s.hero.based}</p>
        </div>
        <a class="hero-cta reveal" style="--d:.65s" href="#work">
          {s.hero.cta}
          <span class="spin" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>

  <section class="crate-section" id="work" data-crate style={`--n:${projects.length}`}>
    <div class="crate-sticky">
      <div class="crate-glow" aria-hidden="true"></div>
      <div class="wrap crate-head">
        <div>
          <span class="label">{s.work.title}{decor.equalizer && <Eq />}</span>
          <h2 class="section-title">{s.work.label}</h2>
        </div>
        <div class="crate-intro">
          <p>{s.work.intro}</p>
          <p class="crate-hint"><span aria-hidden="true">⟷</span> {s.work.hint}</p>
        </div>
      </div>

      <div class="crate-stage">
        <ul class="crate-track">
          {projects.map((p, i) => (
            <li class="crate-item" data-i={i} data-color={p.label}>
              <a href={projectPath(lang, p.slug)} aria-label={`${p.cat} · ${p[lang].title}`} data-crate-link>
                <Album project={p} eager={i < 4} />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="wrap crate-info" aria-live="polite">
        {projects.map((p, i) => (
          <div class="crate-info-item" data-i={i}>
            <p class="crate-cat">{p.cat} · {p.year} · {p.kind[lang]}</p>
            <h3 class="crate-title">{p[lang].title}</h3>
            <a class="crate-open" href={projectPath(lang, p.slug)} tabindex="-1">
              <span class="crate-play" aria-hidden="true"></span>
              {s.work.play}
            </a>
          </div>
        ))}
      </div>

      <div class="wrap crate-controls">
        <button type="button" class="crate-arrow" data-step="-1" aria-label={s.work.prev}>←</button>
        <ol class="crate-index">
          {projects.map((p, i) => (
            <li>
              <button type="button" data-go={i} aria-label={`${s.work.select} ${i + 1}: ${p[lang].title}`}>
                {String(i + 1).padStart(2, '0')}
              </button>
            </li>
          ))}
        </ol>
        <span class="crate-count" data-count>01 / {String(projects.length).padStart(2, '0')}</span>
        <button type="button" class="crate-arrow" data-step="1" aria-label={s.work.next}>→</button>
      </div>
    </div>
  </section>

  <section class="section" id="shipped">
    <div class="wrap">
      <div class="reveal">
        <span class="label">{s.shipped.label}{decor.equalizer && <Eq />}</span>
        <h2 class="section-title">{s.shipped.title}</h2>
        <p class="section-intro">{s.shipped.intro}</p>
      </div>
      <div class="stats">
        {s.shipped.stats.map((st, i) => (
          <div class="stat reveal" style={`--d:${(i % 3) * 0.08}s`}>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <div class="v">
              {st.value}
              {st.unit && <small>{st.unit}</small>}
            </div>
            <p>{st.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="wrap">
      <div class="about-grid">
        <figure class="about-photo reveal">
          <img src={url('me/tree.webp')} width="1200" height="1600" alt={s.about.photoAlt} decoding="async" />
          <figcaption>Dublin</figcaption>
        </figure>
        <div>
          <span class="label reveal">{s.about.label}{decor.equalizer && <Eq />}</span>
          <h2 class="section-title reveal">{s.about.title}</h2>
          <div class="about-text reveal" style="margin-top:32px">
            {s.about.body.map((p) => <p>{p}</p>)}
          </div>
          <div class="tracklist reveal">
            <h3 style="margin-top:24px">{s.about.experience}</h3>
            <ol style="list-style:none;padding:0;margin:0">
              {experience.map((e, i) => (
                <li class="track">
                  <span class="no">{String(i + 1).padStart(2, '0')}</span>
                  <span class="who">
                    {e.company}
                    <span>{e.role[lang]}</span>
                  </span>
                  <span class="when">
                    {e.from === e.to ? e.from : `${e.from} — ${e.to ?? s.about.now}`}
                  </span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="services">
    <div class="wrap">
      <div class="reveal">
        <span class="label">{s.services.label}{decor.equalizer && <Eq />}</span>
        <h2 class="section-title">{s.services.title}</h2>
      </div>
      <ul class="services">
        {s.services.items.map((it) => (
          <li class="service reveal">
            <span class="service-no">{String(s.services.items.indexOf(it) + 1).padStart(2, '0')}</span>
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="contact" id="contact">
    <h2 class="sr-only">{s.contact.title}</h2>
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {[0, 1].map(() => (
          <span class="marquee-group">
            {[0, 1, 2].map(() => (
              <span>{s.contact.title.replace(/\.$/, '')}<i></i></span>
            ))}
          </span>
        ))}
      </div>
    </div>

    <div class="wrap contact-grid">
      <div>
        <span class="label">{s.contact.label}{decor.equalizer && <Eq />}</span>
        <div class="channels">
          <div class="channel">
            <span class="k">{s.contact.email}</span>
            <a class="val" href={`mailto:${contact.email}`}>{contact.email}</a>
            <button class="copy" type="button" data-copy={contact.email} data-done={s.contact.copied}>{s.contact.copy}</button>
          </div>
          {contact.phones.map((ph) => (
            <div class="channel">
              <span class="k">{s.contact.phone}</span>
              <a class="val phone" href={ph.href} target="_blank" rel="noopener">
                <Flag code={ph.flag} label={ph.country[lang]} />
                {ph.number}
              </a>
              <button class="copy" type="button" data-copy={ph.number} data-done={s.contact.copied}>{s.contact.copy}</button>
            </div>
          ))}
        </div>
        <div class="socials">
          <a href={contact.linkedin} target="_blank" rel="noopener">
            <svg class="social-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
            </svg>
            LinkedIn ↗
          </a>
        </div>
      </div>
      <figure class="contact-photo">
        <img src={url('me/mirror.webp')} width="1000" height="1250" alt={s.contact.photoAlt} loading="lazy" decoding="async" />
      </figure>
    </div>

    <div class="wrap">
      <div class="contact-foot">
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        <span class="foot-made">{decor.equalizer && <Eq />}© {new Date().getFullYear()} · {s.footer.made}</span>
        <a href="#top" data-top>↑ {s.footer.top}</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  function initCopy() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      const label = btn.textContent;
      btn.onclick = async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          btn.textContent = btn.dataset.done ?? '✓';
          btn.classList.add('done');
          setTimeout(() => {
            btn.textContent = label;
            btn.classList.remove('done');
          }, 1800);
        } catch {
          /* clipboard blocked: the mailto/tel link still works */
        }
      };
    });
  }
  document.addEventListener('astro:page-load', initCopy);

  // Record crate: page scroll flips through the records sideways, like browsing a shelf.
  type LenisLike = { scrollTo(t: number, o?: Record<string, unknown>): void };
  function initCrate() {
    const sec = document.querySelector<HTMLElement>('[data-crate]');
    if (!sec) return;
    const ctrl = new AbortController();
    const opt = { signal: ctrl.signal };
    document.addEventListener('astro:before-swap', () => ctrl.abort(), { once: true });

    const items = Array.from(sec.querySelectorAll<HTMLElement>('.crate-item'));
    const infos = Array.from(sec.querySelectorAll<HTMLElement>('.crate-info-item'));
    const index = Array.from(sec.querySelectorAll<HTMLButtonElement>('[data-go]'));
    const count = sec.querySelector<HTMLElement>('[data-count]');
    const glow = sec.querySelector<HTMLElement>('.crate-glow');
    const n = items.length;
    const lenis = (window as unknown as { __lenis?: LenisLike | null }).__lenis;
    const pad = (v: number) => String(v).padStart(2, '0');
    let active = -1;

    const geo = () => {
      const top = sec.getBoundingClientRect().top + window.scrollY;
      const run = Math.max(1, sec.offsetHeight - window.innerHeight);
      return { top, run, step: run / (n - 1) };
    };
    const progress = () => {
      const g = geo();
      return Math.min(n - 1, Math.max(0, (window.scrollY - g.top) / g.step));
    };
    const engaged = () => {
      const g = geo();
      return window.scrollY >= g.top - 2 && window.scrollY <= g.top + g.run + 2;
    };
    let busy = false;
    let busyTimer = 0;
    const go = (i: number, immediate = false) => {
      const g = geo();
      const y = g.top + Math.min(n - 1, Math.max(0, i)) * g.step;
      busy = !immediate;
      clearTimeout(busyTimer);
      busyTimer = window.setTimeout(() => (busy = false), 1100);
      if (lenis) lenis.scrollTo(y, { duration: 0.9, immediate, force: true, onComplete: () => (busy = false) });
      else window.scrollTo({ top: y, behavior: immediate ? 'auto' : 'smooth' });
    };

    const setActive = (a: number) => {
      if (a === active) return;
      active = a;
      items.forEach((el, i) => el.classList.toggle('is-active', i === a));
      infos.forEach((el, i) => {
        el.classList.toggle('is-active', i === a);
        el.querySelector('a')?.setAttribute('tabindex', i === a ? '0' : '-1');
      });
      index.forEach((b, i) => b.toggleAttribute('aria-current', i === a));
      if (count) count.textContent = `${pad(a + 1)} / ${pad(n)}`;
      if (glow) glow.style.color = items[a].dataset.color ?? '';
    };

    const render = () => {
      const p = progress();
      const w = items[0].offsetWidth;
      items.forEach((el, i) => {
        const d = i - p;
        const a = Math.abs(d);
        const x = a <= 1 ? d * w * 0.9 : Math.sign(d) * (w * 0.9 + (a - 1) * w * 0.34);
        const rot = -Math.max(-1, Math.min(1, d)) * 58;
        const z = -Math.min(a, 1) * w * 0.5 - Math.max(a - 1, 0) * w * 0.06;
        el.style.transform = `translate3d(${x.toFixed(1)}px, 0, ${z.toFixed(1)}px) rotateY(${rot.toFixed(2)}deg)`;
        el.style.zIndex = String(100 - Math.round(a * 10));
        el.style.opacity = a > 4.6 ? '0' : '1';
      });
      setActive(Math.round(p));
    };

    let raf = 0;
    let idle = 0;
    const onScroll = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(render);
      // Settle on the nearest record once scrolling stops, like a needle finding the track.
      clearTimeout(idle);
      idle = window.setTimeout(() => {
        if (busy || !engaged()) return;
        const p = progress();
        if (Math.abs(p - Math.round(p)) > 0.02) go(Math.round(p));
      }, 160);
    };
    window.addEventListener('scroll', onScroll, { passive: true, ...opt });
    window.addEventListener('resize', render, opt);

    // Clicking a side record brings it to the front; clicking the front one opens it.
    items.forEach((el, i) =>
      el.querySelector('a')?.addEventListener(
        'click',
        (e) => {
          if (i !== active) {
            e.preventDefault();
            go(i);
          } else {
            try {
              sessionStorage.setItem('brl-crate', String(i));
            } catch {}
          }
        },
        opt,
      ),
    );
    infos.forEach((el, i) =>
      el.querySelector('a')?.addEventListener('click', () => {
        try {
          sessionStorage.setItem('brl-crate', String(i));
        } catch {}
      }, opt),
    );
    index.forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.go)), opt));
    sec.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => go(active + Number(b.dataset.step)), opt),
    );
    items.forEach((el, i) => el.querySelector('a')?.addEventListener('focus', () => i !== active && go(i), opt));

    window.addEventListener(
      'keydown',
      (e) => {
        if (!engaged() || e.altKey || e.metaKey || e.ctrlKey) return;
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          go(active + (e.key === 'ArrowRight' ? 1 : -1));
        }
      },
      opt,
    );

    // Sideways gestures: trackpad swipe and touch drag.
    const stage = sec.querySelector<HTMLElement>('.crate-stage')!;
    let acc = 0;
    let accTimer = 0;
    stage.addEventListener(
      'wheel',
      (e) => {
        if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
        e.preventDefault();
        acc += e.deltaX;
        clearTimeout(accTimer);
        accTimer = window.setTimeout(() => (acc = 0), 220);
        if (Math.abs(acc) > 60) {
          go(active + Math.sign(acc));
          acc = 0;
        }
      },
      { passive: false, ...opt },
    );
    let x0: number | null = null;
    let y0 = 0;
    stage.addEventListener('touchstart', (e) => ((x0 = e.touches[0].clientX), (y0 = e.touches[0].clientY)), { passive: true, ...opt });
    stage.addEventListener(
      'touchend',
      (e) => {
        if (x0 === null) return;
        const dx = e.changedTouches[0].clientX - x0;
        const dy = e.changedTouches[0].clientY - y0;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) go(active + (dx < 0 ? 1 : -1));
        x0 = null;
      },
      opt,
    );

    render();

    // Coming back from a project: open the shelf on the record you left from.
    let back: string | null = null;
    try {
      back = sessionStorage.getItem('brl-crate');
      sessionStorage.removeItem('brl-crate');
    } catch {}
    if (back !== null && location.hash === '#work') {
      // The layout also scrolls to #work on load; data-restore tells it to stand aside.
      sec.dataset.restore = '';
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          go(Number(back), true);
          delete sec.dataset.restore;
        }),
      );
    }
  }
  document.addEventListener('astro:page-load', initCrate);
</script>
