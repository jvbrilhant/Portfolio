---
import Layout from '../layouts/Layout.astro';
import Album from './Album.astro';
import Frame from './Frame.astro';
import Tonearm from './Tonearm.astro';
import { decor } from '../data/decor';
import { projects, projectImages, type Lang, type Project } from '../data/projects';
import { t, homePath, projectPath } from '../data/i18n';

interface Props {
  lang: Lang;
  project: Project;
}
const { lang, project } = Astro.props;
const s = t(lang);
const c = project[lang];
const imgs = projectImages(project.slug);
const other: Lang = lang === 'en' ? 'pt' : 'en';
const idx = projects.findIndex((p) => p.slug === project.slug);
const next = projects[(idx + 1) % projects.length];
const sides = (['overview', 'discovery', 'solution', 'result'] as const).map((key, i) => ({
  key,
  no: `${i < 2 ? 'A' : 'B'}${(i % 2) + 1}`,
  title: s.project.sections[key],
  text: c[key],
  images: imgs[key],
}));
// Gallery rows: a lone image gets its own row, the rest go in pairs.
// Images in a row share one height, so nothing is cropped and nothing floats in empty space.
const rows = <T,>(list: T[]): T[][] => {
  const out: T[][] = [];
  let i = 0;
  if (list.length % 2 === 1) out.push([list[i++]]);
  for (; i < list.length; i += 2) out.push(list.slice(i, i + 2));
  return out;
};
---

<Layout
  lang={lang}
  title={c.title}
  description={c.subtitle}
  altPath={projectPath(other, project.slug)}
  image={`og/${project.slug}.jpg`}
>
  {decor.progress && (
    <div class="player" role="progressbar" aria-label={s.project.reading} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-player>
      <div class="player-bar"><span data-player-fill></span></div>
      <div class="player-dock">
        <button type="button" class="player-time" data-player-toggle aria-expanded="false" aria-controls="tracklist">
          <span class="player-icon" aria-hidden="true"></span><span data-player-time>0:00 / 0:00</span>
          <span class="player-caret" aria-hidden="true">▾</span>
        </button>
        <ol class="player-list" id="tracklist">
          {sides.map((sd) => (
            <li>
              <a href={`#track-${sd.key}`} data-track-link={sd.key}>
                <span class="pl-no">{sd.no}</span>
                <span class="pl-title">{sd.title}</span>
                <span class="pl-len" data-len={sd.key}>0:00</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  )}
  <article data-article>
    <header class="p-hero">
      <div class="wrap">
        <a class="back" href={`${homePath(lang)}#work`}><span>←</span> {s.project.back}</a>
        <div class="p-head">
          <div class="p-album">
            <Album project={project} out eager />
            {decor.tonearm && <Tonearm />}
          </div>
          <div>
            <p class="p-cat reveal">{project.cat} · {project.year} · {project.kind[lang]}</p>
            <h1 class="p-title reveal" style="--d:.08s">{c.title}</h1>
            <p class="p-sub reveal" style="--d:.16s">{c.subtitle}</p>
            {project.link && (
              <a class="visit reveal" style="--d:.24s" href={project.link} target="_blank" rel="noopener">
                {s.project.visit} ↗
              </a>
            )}
          </div>
        </div>

        <dl class="credits reveal">
          <div><dt>{s.project.client}</dt><dd>{c.client}</dd></div>
          <div><dt>{s.project.role}</dt><dd>{c.role}</dd></div>
          <div><dt>{s.project.year}</dt><dd>{project.year}</dd></div>
          <div><dt>{s.project.services}</dt><dd>{c.services}</dd></div>
          {c.tools && <div><dt>{s.project.tools}</dt><dd>{c.tools}</dd></div>}
        </dl>

        <div class="g-row single p-cover"><Frame class="reveal" img={imgs.hero} alt={c.title} eager zoomLabel={s.project.zoom} /></div>
      </div>
    </header>

    <div class="wrap">
      {sides.map((sd) => (
        <section class="side-wrap" id={`track-${sd.key}`} data-track={sd.key}>
          <div class="side">
            <div class="side-head reveal">
              <span class="side-no">{s.project.side} {sd.no}</span>
              <h2>{sd.title}</h2>
            </div>
            <div class="side-body reveal">
              {sd.text.map((p) => <p>{p}</p>)}
            </div>
          </div>
          {sd.images.length > 0 && (
            <div class="gallery">
              {rows(sd.images.map((im, i) => ({ im, i }))).map((row) => (
                <div
                  class:list={['g-row', { single: row.length === 1 }]}
                  style={`--sum:${row.reduce((t, { im }) => t + im.w / im.h, 0).toFixed(4)}`}
                >
                  {row.map(({ im, i }) => (
                    <Frame
                      class="reveal"
                      style={`--d:${(i % 2) * 0.08}s`}
                      img={im}
                      alt={`${c.title} — ${sd.title} ${i + 1}`}
                      zoomLabel={s.project.zoom}
                    />
                  ))}
                </div>
              ))}
            </div>
          )}
        </section>
      ))}
    </div>

    <div class="wrap">
      <section class="next">
        <a class="next-link" href={projectPath(lang, next.slug)}>
          <Album project={next} />
          <div>
            <p class="next-label">{s.project.next} · {next.cat}</p>
            <p class="next-title">{next[lang].title}</p>
            <p class="next-sub">{next[lang].subtitle}</p>
          </div>
        </a>
      </section>
      <div class="talk">
        <p>{s.project.talk}</p>
        <a class="visit" style="margin-top:0" href={`${homePath(lang)}#contact`}>{s.project.talkCta} →</a>
      </div>
    </div>
  </article>

  <dialog class="lightbox" data-lenis-prevent aria-label={s.project.gallery}>
    <button type="button" class="lb-btn lb-close" data-lb-close aria-label={s.project.close}>✕</button>
    <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label={s.project.prev}>←</button>
    <div class="lb-stage" data-lb-stage></div>
    <button type="button" class="lb-btn lb-next" data-lb-next aria-label={s.project.nextImage}>→</button>
    <p class="lb-count" data-lb-count></p>
  </dialog>
</Layout>

<script>
  function initLightbox() {
    const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
    if (!dialog) return;
    const items = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lb]'));
    const stage = dialog.querySelector<HTMLElement>('[data-lb-stage]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    let index = 0;

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const d = items[index].dataset;
      stage.innerHTML = '';
      const el = d.video ? document.createElement('video') : document.createElement('img');
      if (el instanceof HTMLVideoElement) {
        el.src = d.video!;
        el.autoplay = el.loop = el.muted = el.playsInline = true;
        el.controls = true;
      } else {
        el.src = d.src!;
        el.alt = d.alt ?? '';
      }
      el.width = Number(d.w);
      el.height = Number(d.h);
      stage.append(el);
      count.textContent = `${index + 1} / ${items.length}`;
    };

    const close = () => {
      dialog.close();
    };

    items.forEach((btn, i) =>
      btn.addEventListener('click', () => {
        show(i);
        dialog.showModal();
        document.documentElement.classList.add('lb-open');
      }),
    );
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('lb-open');
      stage.innerHTML = '';
      items[index]?.focus({ preventScroll: true });
    });
    dialog.querySelector('[data-lb-close]')!.addEventListener('click', close);
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));
    // Clicking the dark area around the image closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === stage) close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });
    // Swipe on touch screens.
    let x0: number | null = null;
    stage.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
      x0 = null;
    });
  }
  document.addEventListener('astro:page-load', initLightbox);

  // Reading progress as a player: total = estimated reading time (200 words/min).
  function initPlayer() {
    const player = document.querySelector<HTMLElement>('[data-player]');
    const article = document.querySelector<HTMLElement>('[data-article]');
    if (!player || !article) return;
    const fill = player.querySelector<HTMLElement>('[data-player-fill]')!;
    const time = player.querySelector<HTMLElement>('[data-player-time]')!;
    const words = (article.innerText.match(/\S+/g) ?? []).length;
    const total = Math.max(60, Math.round((words / 200) * 60));
    const fmt = (sec: number) => `${Math.floor(sec / 60)}:${String(Math.floor(sec % 60)).padStart(2, '0')}`;
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      fill.style.transform = `scaleX(${p})`;
      time.textContent = `${fmt(p * total)} / ${fmt(total)}`;
      player.setAttribute('aria-valuenow', String(Math.round(p * 100)));
      player.classList.toggle('is-playing', p > 0.002 && p < 0.998);
    };
    // Tracklist: each section is a track with its own length; the current one is highlighted.
    const tracks = Array.from(document.querySelectorAll<HTMLElement>('[data-track]'));
    const links = Array.from(player.querySelectorAll<HTMLAnchorElement>('[data-track-link]'));
    tracks.forEach((t) => {
      const w = (t.innerText.match(/\S+/g) ?? []).length;
      const len = player.querySelector(`[data-len="${t.dataset.track}"]`);
      if (len) len.textContent = fmt(Math.max(10, Math.round((w / 200) * 60)));
    });
    const markCurrent = () => {
      let cur = -1;
      tracks.forEach((t, i) => {
        if (t.getBoundingClientRect().top < window.innerHeight * 0.45) cur = i;
      });
      links.forEach((l, i) => l.classList.toggle('is-current', i === cur));
    };
    const toggle = player.querySelector<HTMLButtonElement>('[data-player-toggle]')!;
    toggle.addEventListener('click', () => {
      const open = player.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
    });
    links.forEach((l) =>
      l.addEventListener('click', (e) => {
        e.preventDefault();
        const target = document.getElementById(l.hash.slice(1));
        const lenis = (window as unknown as { __lenis?: { scrollTo(t: HTMLElement, o?: object): void } }).__lenis;
        if (target) lenis ? lenis.scrollTo(target, { offset: -100 }) : target.scrollIntoView({ behavior: 'smooth' });
        player.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      }),
    );

    update();
    markCurrent();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('scroll', markCurrent, { passive: true });
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('scroll', update);
        window.removeEventListener('scroll', markCurrent);
      },
      { once: true },
    );
  }
  document.addEventListener('astro:page-load', initPlayer);
</script>
