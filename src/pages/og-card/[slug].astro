---
/**
 * Share-card template (1200×630) used to generate public/og/<slug>.png.
 * Only built when OG_CARDS=1 (see scripts/og.mjs); never part of the published site.
 */
import '@fontsource-variable/archivo/wdth.css';
import '../../styles/global.css';
import Album from '../../components/Album.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  if (!process.env.OG_CARDS) return [];
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props as { project: Project };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{project.en.title}</title>
  </head>
  <body class="og">
    <div class="og-card" style={`--glow:${project.label}`}>
      <div class="og-album"><Album project={project} out /></div>
      <div class="og-text">
        <p class="og-cat">{project.cat} · {project.year}</p>
        <p class="og-title">{project.en.title}</p>
        <p class="og-brand"><span class="og-disc"></span>Brilhante · Product Designer</p>
      </div>
    </div>
  </body>
</html>

<style is:global>
  body.og {
    margin: 0;
    background: #0b0a10;
  }
  .og-card {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 560px 1fr;
    align-items: center;
    gap: 40px;
    padding: 0 72px 0 70px;
    box-sizing: border-box;
    background:
      radial-gradient(520px 420px at 28% 50%, color-mix(in srgb, var(--glow) 26%, transparent), transparent 70%),
      radial-gradient(600px 500px at 90% 10%, rgba(74, 31, 110, 0.45), transparent 70%),
      #0b0a10;
  }
  .og-album {
    width: 400px;
  }
  .og-album .record-label,
  .og-album .record-spin {
    animation: none !important;
  }
  .og-album .album .record {
    transition: none;
  }
  .og-cat {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--muted);
  }
  .og-title {
    margin-top: 18px;
    font-size: 64px;
    font-weight: 800;
    font-stretch: 112%;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--ink);
  }
  .og-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 40px;
    font-size: 22px;
    font-weight: 600;
    color: var(--accent);
  }
  .og-disc {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background:
      radial-gradient(circle, var(--accent) 0 4px, #1a1624 4.5px 8px, transparent 8.5px),
      repeating-radial-gradient(circle, #1d1a26 0 1px, #2a2536 1.5px 2.5px);
  }
</style>
